# Where the CSV data files and encrypted uploads live. Back this folder up (npm run backup).
DATA_DIR="./data"
# FILES_DIR defaults to $DATA_DIR/files
# FILES_DIR="./data/files"

# Encrypts sensitive CSV columns and uploaded files. Generate with: openssl rand -base64 32
# Keep a copy somewhere safe — without it, encrypted data can't be read.
DATA_ENCRYPTION_KEY=""

# Signs login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public address of the portal (used in email links)
APP_URL="http://localhost:3000"

# School time zone (dates, time clock)
SCHOOL_TZ="America/New_York"

# Email through Resend (https://resend.com). Leave empty in development: emails are printed to the log.
RESEND_API_KEY=""
EMAIL_FROM="Bnos Menachem Portal <portal@your-school-domain.org>"

# Domain for HTTPS (docker-compose / Caddy)
DOMAIN="portal.your-school-domain.org"
